.nh
.TH "BURROW" "1" "Oct 2026" "burrow 0.1.0-dev" "burrow manual"

.SH NAME
burrow-version - print the burrow version


.SH SYNOPSIS
\fBburrow version [flags]\fP


.SH DESCRIPTION
print the burrow version


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for version


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	terminal color policy: auto|always|never

.PP
\fB--config\fP=""
	override the config file path

.PP
\fB--dry-run\fP[=false]
	never mutate; print the plan and exit

.PP
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--no-color\fP[=false]
	disable color (same as --color=never)

.PP
\fB--plain\fP[=false]
	non-interactive plain-text output instead of the TUI

.PP
\fB-y\fP, \fB--yes\fP[=false]
	skip the interactive confirm


.SH SEE ALSO
\fBburrow(1)\fP
