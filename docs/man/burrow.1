.nh
.TH "BURROW" "1" "Oct 2026" "burrow 0.1.0-dev" "burrow manual"

.SH NAME
burrow - a prescriptive Linux disk-space and cleanup tool


.SH SYNOPSIS
\fBburrow [flags]\fP


.SH DESCRIPTION
a prescriptive Linux disk-space and cleanup tool


.SH OPTIONS
\fB--color\fP="auto"
	terminal color policy: auto|always|never

.PP
\fB--config\fP=""
	override the config file path

.PP
\fB--dry-run\fP[=false]
	never mutate; print the plan and exit

.PP
\fB--exclude\fP=[]
	comma list of categories or item ids to exclude

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for burrow

.PP
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--log-level\fP="info"
	trace|debug|info|warn|error

.PP
\fB--min-size\fP="0"
	only act on items >= size (e.g. 10M, 1G)

.PP
\fB--no-color\fP[=false]
	disable color (same as --color=never)

.PP
\fB--only\fP=[]
	comma list of categories or item ids to include

.PP
\fB--quiet\fP[=false]
	only print errors

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	shorthand for --log-level debug

.PP
\fB-y\fP, \fB--yes\fP[=false]
	skip the interactive confirm


.SH SEE ALSO
\fBburrow-analyze(1)\fP, \fBburrow-clean(1)\fP, \fBburrow-completion(1)\fP, \fBburrow-config(1)\fP, \fBburrow-docs(1)\fP, \fBburrow-history(1)\fP, \fBburrow-purge(1)\fP, \fBburrow-status(1)\fP, \fBburrow-version(1)\fP
