.nh
.TH "BURROW" "1" "Oct 2026" "burrow 0.1.0-dev" "burrow manual"

.SH NAME
burrow-completion-fish - Generate the autocompletion script for fish


.SH SYNOPSIS
\fBburrow completion fish [flags]\fP


.SH DESCRIPTION
Generate the autocompletion script for the fish shell.

.PP
To load completions in your current shell session:

.EX
burrow completion fish | source
.EE

.PP
To load completions for every new session, execute once:

.EX
burrow completion fish > ~/.config/fish/completions/burrow.fish
.EE

.PP
You will need to start a new shell for this setup to take effect.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for fish

.PP
\fB--no-descriptions\fP[=false]
	disable completion descriptions


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	terminal color policy: auto|always|never

.PP
\fB--config\fP=""
	override the config file path

.PP
\fB--dry-run\fP[=false]
	never mutate; print the plan and exit

.PP
\fB--exclude\fP=[]
	comma list of categories or item ids to exclude

.PP
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--log-level\fP="info"
	trace|debug|info|warn|error

.PP
\fB--min-size\fP="0"
	only act on items >= size (e.g. 10M, 1G)

.PP
\fB--no-color\fP[=false]
	disable color (same as --color=never)

.PP
\fB--only\fP=[]
	comma list of categories or item ids to include

.PP
\fB--quiet\fP[=false]
	only print errors

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	shorthand for --log-level debug

.PP
\fB-y\fP, \fB--yes\fP[=false]
	skip the interactive confirm


.SH SEE ALSO
\fBburrow-completion(1)\fP
