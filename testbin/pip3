#!/bin/sh
# Test stub for pip3. Records argv and answers `cache dir` with a path under
# BURROW_TEST_HOME.
log="${BURROW_TESTBIN_LOG:-/dev/null}"
{ printf 'argv: pip3'; for a in "$@"; do printf ' %s' "$a"; done; printf '\n'; } >>"$log"
case "$1 $2" in
  "cache dir") echo "${BURROW_TEST_HOME}/.cache/pip" ;;
  *) echo "" ;;
esac