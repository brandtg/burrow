#!/bin/sh
# Test stub for pnpm. Records argv and answers `store path` with a path under
# BURROW_TEST_HOME so tests can point it at a fixture tree.
log="${BURROW_TESTBIN_LOG:-/dev/null}"
{ printf 'argv: pnpm'; for a in "$@"; do printf ' %s' "$a"; done; printf '\n'; } >>"$log"
case "$1 $2" in
  "store path") echo "${BURROW_TEST_HOME}/.local/share/pnpm/store" ;;
  *) echo "" ;;
esac